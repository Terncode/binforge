{
  "name": "binforge",
  "version": "1.1.0",
  "description": "A compact, dependency-free binary serializer for TypeScript, with variant lengths, string interning, bit packing, and explicit little- and big-endian primitives.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Terncode/binforge.git"
  },
  "homepage": "https://github.com/Terncode/binforge#readme",
  "bugs": {
    "url": "https://github.com/Terncode/binforge/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./constants": {
      "import": {
        "types": "./dist/constants.d.ts",
        "default": "./dist/constants.js"
      },
      "require": {
        "types": "./dist/constants.d.cts",
        "default": "./dist/constants.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --config eslint.config.mjs \"src/**/*.ts\"",
    "lint-fix": "eslint --fix --config eslint.config.mjs \"src/**/*.ts\"",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "keywords": [
    "binforge",
    "binary",
    "serialization",
    "serializer",
    "deserializer",
    "encoder",
    "decoder",
    "binary-reader",
    "binary-writer",
    "buffer",
    "dataview",
    "varint",
    "bitpacking",
    "endianness",
    "little-endian",
    "big-endian",
    "uint8array",
    "typescript"
  ],
  "author": "Terncode",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "^78.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
